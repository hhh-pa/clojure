r-realized-atom THROW java.lang.ClassCastException|"class clojure.lang.Atom cannot be cast to class clojure.lang.IPending (clojure.lang.Atom and clojure.lang.IPending are in unnamed module of loader 'app')"
r-realized-num THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class clojure.lang.IPending (java.lang.Long is in module java.base of loader 'bootstrap'; clojure.lang.IPending is in unnamed module of loader 'app')"
r-eq-same true
r-eq-distinct false
r-identical true
r-counted false
r-ifn true
