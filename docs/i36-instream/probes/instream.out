in-class clojure.lang.LineNumberingPushbackReader
in-pr "#object[clojure.lang.LineNumberingPushbackReader 0xH \"clojure.lang.LineNumberingPushbackReader@H\"]"
wis-class clojure.lang.LineNumberingPushbackReader
rl-basic ["a" "b" nil]
rl-crlf ["a" "b" nil]
rl-cr ["a" "b" nil]
rl-mixed ["a" "" "b" "c" "d" nil]
rl-empty nil
rl-trailing-nl ["a" nil]
rl-empty-lines ["a" "" "b" nil]
rl-nil-in THROW java.lang.NullPointerException|"Cannot invoke \"java.io.BufferedReader.readLine()\" because the return value of \"clojure.lang.Var.get()\" is null"
rl-str-in THROW java.lang.ClassCastException|"class java.lang.String cannot be cast to class java.io.BufferedReader (java.lang.String and java.io.BufferedReader are in module java.base of loader 'bootstrap')"
rl-num-in THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class java.io.BufferedReader (java.lang.Long and java.io.BufferedReader are in module java.base of loader 'bootstrap')"
r-basic [1 2]
r-shapes [1 1.5 "s" :k sym \c]
r-comment 42
r-discard 2
r-meta ["[1]" {:k true}]
r-eof-val :eof
r-eof-nil nil
r-eof-false false
r-eof-ws :eof
r-eof-throw THROW java.lang.RuntimeException|"EOF while reading"
r-eof-3 THROW java.lang.RuntimeException|"EOF while reading"
r-trunc THROW java.lang.RuntimeException|"EOF while reading, starting at line 1"
r-trunc-str THROW java.lang.RuntimeException|"EOF while reading string"
r-trunc-char THROW java.lang.RuntimeException|"EOF while reading character"
r-trunc-regex THROW java.lang.RuntimeException|"EOF while reading regex"
r-opts-eof :x
r-opts-eofnil nil
r-opts-noeof THROW java.lang.RuntimeException|"EOF while reading"
r-opts-unknown 1
r-opts-nonmap THROW java.lang.ClassCastException|"class clojure.lang.Keyword cannot be cast to class clojure.lang.IPersistentMap (clojure.lang.Keyword and clojure.lang.IPersistentMap are in unnamed module of loader 'app')"
r-opts-nil 1
r-eoferr-truthy THROW java.lang.RuntimeException|"EOF while reading"
r-eoferr-nil :eof
r-readcond-allow 1
r-readcond-preserve #?(:clj 1 :default 2)
r-features 1
r-recursive 1
r-recursive-discard 2
r-kw-colons :a:b
r-baddelim THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Unmatched delimiter: )"
r-baddelim-exdata #:clojure.error{:line 1, :column 2}
r-cond-plain THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Conditional read not allowed"
r-splice-opts THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Reader conditional splicing not allowed at the top level."
r-splice-nested (1 2 3)
r-cond-opts-absent THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Conditional read not allowed"
r-splice-top THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Conditional read not allowed"
r-splice-then-ok [:threw (clojure.core/deref (:clj [1]))]
r-line-meta {:line 2, :column 1}
r-nil-stream THROW java.lang.NullPointerException|"Cannot invoke \"java.io.Reader.read()\" because \"r\" is null"
r-str-stream THROW java.lang.ClassCastException|"class java.lang.String cannot be cast to class java.io.PushbackReader (java.lang.String and java.io.PushbackReader are in module java.base of loader 'bootstrap')"
r-eof-outer THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: EOF while reading"
r-trunc-outer THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: EOF while reading, starting at line 1"
r-recursive-outer THROW java.lang.RuntimeException|"EOF while reading"
r-exdata #:clojure.error{:line 2, :column 1}
r-exdata-eof #:clojure.error{:line 1, :column 1}
r-excause "java.lang.RuntimeException"
mix-1 ["a" (b)]
mix-2 [1 " 2"]
mix-3 [(a) " tail"]
ls-basic THROW java.lang.ClassCastException|"class clojure.lang.LineNumberingPushbackReader cannot be cast to class java.io.BufferedReader (clojure.lang.LineNumberingPushbackReader is in unnamed module of loader 'app'; java.io.BufferedReader is in module java.base of loader 'bootstrap')"
ls-class THROW java.lang.ClassCastException|"class clojure.lang.LineNumberingPushbackReader cannot be cast to class java.io.BufferedReader (clojure.lang.LineNumberingPushbackReader is in unnamed module of loader 'app'; java.io.BufferedReader is in module java.base of loader 'bootstrap')"
ls-lazy THROW java.lang.ClassCastException|"class clojure.lang.LineNumberingPushbackReader cannot be cast to class java.io.BufferedReader (clojure.lang.LineNumberingPushbackReader is in unnamed module of loader 'app'; java.io.BufferedReader is in module java.base of loader 'bootstrap')"
ls-empty THROW java.lang.ClassCastException|"class clojure.lang.LineNumberingPushbackReader cannot be cast to class java.io.BufferedReader (clojure.lang.LineNumberingPushbackReader is in unnamed module of loader 'app'; java.io.BufferedReader is in module java.base of loader 'bootstrap')"
ls-basic2 ("x" "y")
ls-class2 clojure.lang.Cons
ls-lazy2 [false "y" true]
ls-empty2 nil
ls-eager :threw-at-call
ls-str-eager :threw-at-call
ls-noclose false
ls-nil THROW java.lang.NullPointerException|"Cannot invoke \"java.io.BufferedReader.readLine()\" because \"rdr\" is null"
ls-str THROW java.lang.ClassCastException|"class java.lang.String cannot be cast to class java.io.BufferedReader (java.lang.String and java.io.BufferedReader are in module java.base of loader 'bootstrap')"
wis-val :body
wis-restore true
wis-nested ["a" "b" nil]
wis-read [1 2]
wis-num THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class java.lang.String (java.lang.Long and java.lang.String are in module java.base of loader 'bootstrap')"
rs-empty THROW java.lang.RuntimeException|"EOF while reading"
rs-trunc THROW java.lang.RuntimeException|"EOF while reading"
rs-cond THROW java.lang.RuntimeException|"Conditional read not allowed"
r-2arity-boolstream THROW java.lang.ClassCastException|"class java.lang.Boolean cannot be cast to class java.io.PushbackReader (java.lang.Boolean and java.io.PushbackReader are in module java.base of loader 'bootstrap')"
r-optsbad-nilstream THROW java.lang.ClassCastException|"class clojure.lang.Keyword cannot be cast to class clojure.lang.IPersistentMap (clojure.lang.Keyword and clojure.lang.IPersistentMap are in unnamed module of loader 'app')"
r-eofopts-nilstream THROW java.lang.NullPointerException|"Cannot invoke \"java.io.Reader.read()\" because \"r\" is null"
r-feat-vec THROW java.lang.ClassCastException|"class clojure.lang.PersistentVector cannot be cast to class clojure.lang.IPersistentSet (clojure.lang.PersistentVector and clojure.lang.IPersistentSet are in unnamed module of loader 'app')"
r-feat-nil 2
r-feat-set-nonkw 1
r-rc-bogus THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Conditional read not allowed"
r-rc-nil THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: Conditional read not allowed"
r-arity5 THROW clojure.lang.ArityException|"Wrong number of args (5) passed to: clojure.core/read"
r-opts-mapentry THROW java.lang.ClassCastException|"class clojure.lang.MapEntry cannot be cast to class clojure.lang.IPersistentMap (clojure.lang.MapEntry and clojure.lang.IPersistentMap are in unnamed module of loader 'app')"
rl-arity1 THROW clojure.lang.ArityException|"Wrong number of args (1) passed to: clojure.core/read-line"
wis-arity0 THROW clojure.lang.ArityException|"Wrong number of args (0) passed to: clojure.core/with-in-str"
r-preserve-fail-then-tag THROW clojure.lang.LispReader$ReaderException|"java.lang.RuntimeException: No reader function for tag foo"
