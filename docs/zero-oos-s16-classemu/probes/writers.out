w-class java.io.PrintWriter
w-print #object[java.io.PrintWriter 0xH "java.io.PrintWriter@L"]
w-arity3-class java.io.PrintWriter
w-arity1 THROW clojure.lang.ArityException|"Wrong number of args (1) passed to: clojure.core/PrintWriter-on"
w-arity4 THROW clojure.lang.ArityException|"Wrong number of args (4) passed to: clojure.core/PrintWriter-on"
w-write-flush ["hi"]
w-flush-empty []
w-close [["x"] true]
w-close-nil :closed
w-println ["a\n"]
w-flush-default true
w-noflush-noauto []
w-noflush-auto []
w-flush-noauto ["a\n"]
w-print-newline-auto []
w-flush-call ["z"]
w-prn-to ["{:a 1}\n"]
w-nonfn-construct java.io.PrintWriter
w-nonfn-flush THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class clojure.lang.IFn (java.lang.Long is in module java.base of loader 'bootstrap'; clojure.lang.IFn is in unnamed module of loader 'app')"
w-close-twice 1
w-write-after-close []
w-direct-println-auto ["a\n"]
w-direct-println-noauto []
w-direct-print-auto []
w-flush-ret nil
w-close-ret nil
