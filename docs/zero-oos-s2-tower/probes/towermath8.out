r8-intp false
r8-integerp true
r8-numberp true
r8-rationalp true
r8-ratiop false
r8-decp false
r8-floatp false
r8-hash true
r8-hash2 true
r8-bigrd 5N
r8-bigdrd 5M
r8-numrd 5
r8-ratrd 5
r8-add 6N
r8-add2 7N
r8-mul 10N
r8-div 3N
r8-div2 1/2
r8-inc 6N
r8-quot 3N
r8-lt true
r8-typeop clojure.lang.BigInt
r8-typemin java.math.BigInteger
r8-int 5
r8-long 5
r8-double 5.0
r8-strmodedirect THROW java.lang.ClassCastException|"class java.lang.String cannot be cast to class java.lang.Number (java.lang.String and java.lang.Number are in module java.base of loader 'bootstrap')"
r8-quotscale 2.00M
r8-quotscale0 2.00M
r8-quotz 0.000M
r8-remz 0.333M
