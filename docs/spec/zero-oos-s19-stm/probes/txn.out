t-shape-dosync (clojure.core/sync nil (alter r inc))
t-shape-sync (. clojure.lang.LockingTransaction (clojure.core/runInTransaction (clojure.core/fn [] (alter r inc))))
t-shape-io (if (clojure.lang.LockingTransaction/isRunning) (throw (new java.lang.IllegalStateException "I/O in transaction")) (do :x))
t-shape-io-multi (if (clojure.lang.LockingTransaction/isRunning) (throw (new java.lang.IllegalStateException "I/O in transaction")) (do 1 2 3))
