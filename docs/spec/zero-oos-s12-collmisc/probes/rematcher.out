rm-class "class java.util.regex.Matcher"
rm-print "#object[java.util.regex.Matcher 0xH \"java.util.regex.Matcher[pattern=a+ region=0,4 lastmatch=]\"]"
rm-find-groups [["12-34" "12" "34"] ["12-34" "12" "34"]]
rm-find-plain ["aa" "aa"]
rm-find-none true
rm-groups-nomatch THROW java.lang.IllegalStateException|"No match found"
rm-groups-fresh THROW java.lang.IllegalStateException|"No match found"
rm-multi ["a" "a" nil]
rm-groups-each [["ab" "a" "b"] ["ab" "a" "b"] ["a" "a" nil] ["a" "a" nil]]
rm-exhaust ["a" nil nil]
rm-bad-pattern THROW java.lang.ClassCastException|"class java.lang.String cannot be cast to class java.util.regex.Pattern (java.lang.String and java.util.regex.Pattern are in module java.base of loader 'bootstrap')"
rm-bad-subject THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class java.lang.CharSequence (java.lang.Long and java.lang.CharSequence are in module java.base of loader 'bootstrap')"
rm-nil-subject THROW java.lang.NullPointerException|"Cannot invoke \"java.lang.CharSequence.length()\" because \"this.text\" is null"
rm-groups-bad THROW java.lang.ClassCastException|"class java.lang.String cannot be cast to class java.util.regex.Matcher (java.lang.String and java.util.regex.Matcher are in module java.base of loader 'bootstrap')"
rm-empty-advance ["" "" nil]
