w-arglists ([& body])
w-macro true
w-basic 3
w-empty nil
w-expand ((clojure.core/fn loading__N__auto__ [] (. clojure.lang.Var (clojure.core/pushThreadBindings #:clojure.lang.Compiler{LOADER (.getClassLoader (.getClass loading__N__auto__))})) (try (load "a") (load "b") (finally (. clojure.lang.Var (clojure.core/popThreadBindings))))))
