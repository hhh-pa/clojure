c-unbuf-class => clojure.core.async.impl.channels.ManyToManyChannel
c-unbuf-pr => "#object[clojure.core.async.impl.channels.ManyToManyChannel 0xHEX \"clojure.core.async.impl.channels.ManyToManyChannel@HEX\"]"
c-fixed-pr => "#object[clojure.core.async.impl.channels.ManyToManyChannel 0xHEX \"clojure.core.async.impl.channels.ManyToManyChannel@HEX\"]"
c-nil-pr => "#object[clojure.core.async.impl.channels.ManyToManyChannel 0xHEX \"clojure.core.async.impl.channels.ManyToManyChannel@HEX\"]"
c-buf-pr => "#object[clojure.core.async.impl.channels.ManyToManyChannel 0xHEX \"clojure.core.async.impl.channels.ManyToManyChannel@HEX\"]"
c-drop-pr => "#object[clojure.core.async.impl.buffers.DroppingBuffer 0xHEX \"clojure.core.async.impl.buffers.DroppingBuffer@HEX\"]"
c-slip-pr => "#object[clojure.core.async.impl.buffers.SlidingBuffer 0xHEX \"clojure.core.async.impl.buffers.SlidingBuffer@HEX\"]"
c-dropbuf-class => clojure.core.async.impl.buffers.DroppingBuffer
c-slipbuf-class => clojure.core.async.impl.buffers.SlidingBuffer
c-fixbuf-class => clojure.core.async.impl.buffers.FixedBuffer
c-eq-self => true
c-eq-other => false
c-hash-eq => true
f-put1 => true
f-put2 => true
f-take1 => :a
f-take2 => :b
d-puts => [true true true]
d-takes => [1 2]
s-puts => [true true true]
s-takes => [2 3]
x-close-ret => nil
x-closed? => true
x-put-closed => false
x-drain => :x
x-take-closed => nil
x-close-again => nil
x-closed?-still => true
u-closed-take => nil
u-closed-put => false
e-nil-put => THROW java.lang.IllegalArgumentException | "Can't put nil on channel"
e-buf0 => THROW java.lang.AssertionError | "Assert failed: fixed buffers must have size > 0\n(pos? n)"
e-bufneg => THROW java.lang.AssertionError | "Assert failed: fixed buffers must have size > 0\n(pos? n)"
e-chan0 => THROW java.lang.AssertionError | "Assert failed: fixed buffers must have size > 0\n(pos? n)"
e-take-nonchan => THROW java.lang.IllegalArgumentException | "No implementation of method: :take! of protocol: #'clojure.core.async.impl.protocols/ReadPort found for class: java.lang.Long"
e-put-nonchan => THROW java.lang.IllegalArgumentException | "No implementation of method: :put! of protocol: #'clojure.core.async.impl.protocols/WritePort found for class: clojure.lang.Keyword"
e-take-nil => THROW java.lang.IllegalArgumentException | "No implementation of method: :take! of protocol: #'clojure.core.async.impl.protocols/ReadPort found for class: nil"
e-close-nonchan => THROW java.lang.IllegalArgumentException | "No implementation of method: :close! of protocol: #'clojure.core.async.impl.protocols/Channel found for class: java.lang.String"
e-closed-nonchan => THROW java.lang.IllegalArgumentException | "No implementation of method: :closed? of protocol: #'clojure.core.async.impl.protocols/Channel found for class: java.lang.String"
e-chan-str => THROW java.lang.IllegalArgumentException | "No implementation of method: :full? of protocol: #'clojure.core.async.impl.protocols/Buffer found for class: java.lang.String"
e-bang-outside-go => THROW java.lang.AssertionError | "Assert failed: <! used not in (go ...) block\nnil"
e-rbang-outside-go => THROW java.lang.AssertionError | "Assert failed: >! used not in (go ...) block\nnil"
