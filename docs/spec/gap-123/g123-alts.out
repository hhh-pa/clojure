a-take => [:ready :c1]
a-put => [true :c2]
a-put-took => :v
a-closed => [nil :c1]
a-put-closed => [false :c2]
a-default => [:dflt :default]
a-default-nil => [nil :default]
a-ready-beats-default => [:ready :c1]
a-priority => [:first :c1]
a-priority-rev => [:second :c2]
a-woken => [:late :c2]
a-put-woken-take => :pv
a-put-woken => [true :c1]
a-set => [:in-set true]
a-nil => ["class java.lang.AssertionError" "Assert failed: alts must have at least one channel operation\n(pos? (count ports))"]
e-alts-str => THROW java.lang.IllegalArgumentException | "No implementation of method: :take! of protocol: #'clojure.core.async.impl.protocols/ReadPort found for class: java.lang.Character"
e-alts-empty => THROW java.lang.AssertionError | "Assert failed: alts must have at least one channel operation\n(pos? (count ports))"
e-alts-nil-put => THROW java.lang.AssertionError | "Assert failed: can't put nil on channel\n(some? (port 1))"
e-alts-nonchan => THROW java.lang.IllegalArgumentException | "No implementation of method: :take! of protocol: #'clojure.core.async.impl.protocols/ReadPort found for class: java.lang.Long"
e-alts-odd-opts => THROW java.lang.IllegalArgumentException | "No value supplied for key: :default"
e-alts-list-op => THROW java.lang.IllegalArgumentException | "No implementation of method: :take! of protocol: #'clojure.core.async.impl.protocols/ReadPort found for class: clojure.lang.PersistentList"
e-altsbang-outside-go => THROW java.lang.AssertionError | "Assert failed: alts! used not in (go ...) block\nnil"
