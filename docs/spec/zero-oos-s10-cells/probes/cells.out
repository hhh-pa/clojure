c-new #object[clojure.lang.Volatile 0xH {:status :ready, :val 0}]
c-new-nil #object[clojure.lang.Volatile 0xH {:status :ready, :val nil}]
c-new-coll #object[clojure.lang.Volatile 0xH {:status :ready, :val {:a [1 2]}}]
c-pred-t true
c-pred-atom false
c-pred-int false
c-pred-nil false
c-pred-str false
c-deref 5
c-deref-reader 7
c-deref-timeout THROW java.lang.ClassCastException|"class clojure.lang.Volatile cannot be cast to class java.util.concurrent.Future (clojure.lang.Volatile is in unnamed module of loader 'app'; java.util.concurrent.Future is in module java.base of loader 'bootstrap')"
c-deref-nil THROW java.lang.NullPointerException|"Cannot invoke \"java.util.concurrent.Future.get()\" because \"fut\" is null"
c-vreset [9 9]
c-vreset-nil [nil nil]
c-vreset-nonvol THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class clojure.lang.Volatile (java.lang.Long is in module java.base of loader 'bootstrap'; clojure.lang.Volatile is in unnamed module of loader 'app')"
c-vreset-nil-vol THROW java.lang.NullPointerException|"Cannot invoke \"clojure.lang.Volatile.reset(Object)\" because \"vol\" is null"
c-vswap [5 5]
c-vswap-multi [7 7]
c-vswap-noargs [2 2]
c-vswap-nonfn THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class clojure.lang.IFn (java.lang.Long is in module java.base of loader 'bootstrap'; clojure.lang.IFn is in unnamed module of loader 'app')"
c-vswap-nonvol THROW java.lang.ClassCastException|"class clojure.lang.Atom cannot be cast to class clojure.lang.Volatile (clojure.lang.Atom and clojure.lang.Volatile are in unnamed module of loader 'app')"
c-shape (.reset v (+ (.deref v) 5))
c-shape-multi (.reset v (f (.deref v) 1 2))
c-shape-noargs (.reset v (inc (.deref v)))
c-double-eval [2 2]
c-eq-same true
c-eq-distinct false
c-identical true
c-meta nil
c-ifn false
c-counted false
