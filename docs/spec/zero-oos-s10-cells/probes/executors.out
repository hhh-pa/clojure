e-set-ret true
e-routes [1 "s10-probe-pool"]
e-nil-set :restored
e-nil-send ["clojure.lang.Agent" 0 true]
e-non-exec THROW java.lang.ClassCastException|"class clojure.lang.Keyword cannot be cast to class java.util.concurrent.ExecutorService (clojure.lang.Keyword is in unnamed module of loader 'app'; java.util.concurrent.ExecutorService is in module java.base of loader 'bootstrap')"
e-non-exec-pool-ok [:caught 1]
e-off-ret true
e-off-routes [1 "s10-probe-off"]
e-off-nil-set :restored
e-off-non-exec THROW java.lang.ClassCastException|"class java.lang.Long cannot be cast to class java.util.concurrent.ExecutorService (java.lang.Long and java.util.concurrent.ExecutorService are in module java.base of loader 'bootstrap')"
e-cross true
e-restored true
